{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake -S . -B build",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "dependsOn": "configure"
    },
    {
      "label": "run app",
      "type": "shell",
      "command": "open ./build/InternScout.app",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "search (command line)",
      "type": "shell",
      "command": "./build/internscout search",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "install (app + command line)",
      "type": "shell",
      "command": "cmake --install build",
      "dependsOn": "build",
      "problemMatcher": []
    }
  ]
}
